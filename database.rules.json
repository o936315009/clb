{
  "rules": {
    "system": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('system/developers').child(auth.uid).val() === true"
    },
    "roles": {
      ".read": true,
      ".write": "auth != null && root.child('system/developers').child(auth.uid).val() === true"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('system/developers').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('system/developers').child(auth.uid).val() === true)"
      }
    },
    "memberships": {
      "$clubId": {
        ".read": true,
        "$uid": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    "clubs": {
      "$clubId": {
        ".read": true,
        ".write": "auth != null",
        "attendance": {
          ".write": "auth != null && (root.child('system/developers').child(auth.uid).val() === true || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'ADMIN' || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'VICE_ADMIN' || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'TREASURER')"
        },
        "tournaments": {
          ".write": "auth != null && (root.child('system/developers').child(auth.uid).val() === true || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'ADMIN' || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'VICE_ADMIN' || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'REFEREE')"
        },
        "transactions": {
          ".write": "auth != null && (root.child('system/developers').child(auth.uid).val() === true || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'ADMIN' || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'TREASURER')"
        },
        "wallets": {
          ".write": "auth != null && (root.child('system/developers').child(auth.uid).val() === true || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'ADMIN' || root.child('memberships').child($clubId).child(auth.uid).child('role').val() === 'TREASURER')"
        }
      }
    }
  }
}
